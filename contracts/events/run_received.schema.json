{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_received.schema.json",
  "title": "RunReceived",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "schema_version",
    "run_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "RunReceived"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "required": [
        "commit_sha",
        "branch",
        "raw_ref",
        "received_at"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "raw_ref": {
          "type": "string",
          "pattern": "^/internal/runs/"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
